    "aws_lambda_function": {
      "ap_northeast_1": {
        "provider": "aws.ap_northeast_1",
        "count": "${var.enable_functions && (length(var.regions_to_enable) == 0 || contains(var.regions_to_enable, \"ap-northeast-1\")) ? 1 : 0}",
        "function_name": "${var.name}",
        "role": "${aws_iam_role.lambda.arn}",
        "package_type": "Image",
        "image_uri": "${aws_ecr_repository.ap_northeast_1.repository_url}@${data.aws_ecr_image.ap_northeast_1[0].image_digest}",
        "architectures": [
          "arm64"
        ],
        "memory_size": 256,
        "timeout": 150,
        "environment": [
          {
            "variables": {
              "RELAY_URL": "https://${aws_instance.relay.public_ip}:4433",
              "EXPERIMENT_TOKEN": "${var.experiment_token}",
              "CERTIFICATE_HASH": "${var.certificate_hash}"
            }
          }
        ],
        "depends_on": [
          "aws_iam_role_policy_attachment.lambda_logs",
          "aws_cloudwatch_log_group.ap_northeast_1",
          "aws_ecr_repository_policy.ap_northeast_1"
        ]
      },
      "ap_northeast_2": {
        "provider": "aws.ap_northeast_2",
